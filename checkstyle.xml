<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE module PUBLIC "-//Checkstyle//DTD Check Configuration 1.3//EN" "https://checkstyle.org/dtds/configuration_1_3.dtd">
<module name="Checker">
  <!-- Exclude generated source files from checkstyle -->
  <module name="BeforeExecutionExclusionFileFilter">
    <property name="fileNamePattern" value=".*[\\/]target[\\/]generated-sources[\\/].*$" />
  </module>
  <module name="TreeWalker">
    <!-- Disallow usage of wildcard imports (e.g., import java.util.*) to encourage explicit
        imports -->
    <module name="AvoidStarImport" />
    <!-- Detect and disallow redundant import statements -->
    <module name="RedundantImport" />
    <!-- Enforce consistent code indentation for better readability -->
    <module name="Indentation">
      <!-- Set tab width to 4 spaces -->
      <property name="tabWidth" value="4" />
      <!-- Set basic offset for indentation to 4 spaces -->
      <property name="basicOffset" value="4" />
      <!-- Match array init indent to formatter output (1 extra level = 4 spaces) -->
      <property name="arrayInitIndent" value="4" />
      <!-- Do not enforce strict condition to allow autoformatter styles -->
      <property name="forceStrictCondition" value="false" />
    </module>
    <!-- Remove unused import statements, including in Javadoc -->
    <module name="UnusedImports">
      <!-- Also check for unused imports in Javadoc comments -->
      <property name="processJavadoc" value="true" />
    </module>
    <!-- Disallow trailing commas after the last constant in enums for cleaner syntax -->
    <module name="NoEnumTrailingComma" />
  </module>
  <!-- Limit maximum line length to improve readability -->
  <module name="LineLength">
    <!-- Ignore long lines in Javadoc @see tags -->
    <property name="ignorePattern" value="^ *\* *@see.+$" />
    <!-- Set maximum allowed line length -->
    <property name="max" value="180" />
  </module>
  <!-- Require a newline at the end of each file to comply with POSIX and improve diff behavior -->
  <module name="NewlineAtEndOfFile" />
</module>
