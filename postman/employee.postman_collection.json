{
  "info": {
    "name": "MS Employee",
    "description": "API de empleados. Defina apiUser y apiPassword en el entorno (no se guardan en la colección).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "basic",
    "basic": [
      {
        "key": "username",
        "value": "{{apiUser}}",
        "type": "string"
      },
      {
        "key": "password",
        "value": "{{apiPassword}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "employeeId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "POST /employees (uno o varios)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/employees",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "employees"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "[\n  {\n    \"firstName\": \"Ana\",\n    \"middleName\": \"María\",\n    \"paternalSurname\": \"García\",\n    \"maternalSurname\": \"López\",\n    \"gender\": \"FEMALE\",\n    \"birthDate\": \"17-05-1990\",\n    \"jobTitle\": \"Ingeniera\"\n  },\n  {\n    \"firstName\": \"Luis\",\n    \"paternalSurname\": \"Marín\",\n    \"gender\": \"MALE\",\n    \"age\": 41,\n    \"birthDate\": \"01-01-1985\",\n    \"jobTitle\": \"Analista\"\n  }\n]"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('201 Created', () => pm.response.to.have.status(201));",
              "const body = pm.response.json();",
              "pm.test('devuelve los 2 empleados con id, edad y alta', () => { pm.expect(body).to.have.length(2); pm.expect(body[0].id).to.be.a('number'); pm.expect(body[0].age).to.be.a('number'); pm.expect(body[0].createdAt).to.be.a('string'); });",
              "pm.collectionVariables.set('employeeId', body[0].id);"
            ]
          }
        }
      ]
    },
    {
      "name": "GET /employees (paginado)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/employees?limit=1",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "employees"
          ],
          "query": [
            {
              "key": "limit",
              "value": "1"
            }
          ]
        },
        "description": "Parámetros opcionales: limit (1-100), cursor (opaco), includeInactive."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "pm.test('tiene items', () => pm.expect(pm.response.json().items).to.be.an('array'));"
            ]
          }
        }
      ]
    },
    {
      "name": "GET /employees/{id}",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/employees/{{employeeId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "employees",
            "{{employeeId}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "GET /employees/search?name=",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/employees/search?name=mar",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "employees",
            "search"
          ],
          "query": [
            {
              "key": "name",
              "value": "mar"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "pm.test('al menos una coincidencia', () => pm.expect(pm.response.json().items.length).to.be.above(0));"
            ]
          }
        }
      ]
    },
    {
      "name": "PUT /employees/{id} (parcial)",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/employees/{{employeeId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "employees",
            "{{employeeId}}"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"jobTitle\": \"Líder técnica\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "pm.test('puesto actualizado', () => pm.expect(pm.response.json().jobTitle).to.eql('Líder técnica'));"
            ]
          }
        }
      ]
    },
    {
      "name": "DELETE /employees/{id} (baja lógica)",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/employees/{{employeeId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "employees",
            "{{employeeId}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('204 No Content', () => pm.response.to.have.status(204));"
            ]
          }
        }
      ]
    },
    {
      "name": "GET /employees/{id} inexistente (404)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/employees/999999",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "employees",
            "999999"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('404 Not Found', () => pm.response.to.have.status(404));",
              "pm.test('ProblemDetail', () => pm.expect(pm.response.json().title).to.eql('Empleado no encontrado'));"
            ]
          }
        }
      ]
    },
    {
      "name": "POST inválido (400)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/employees",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "employees"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "[\n  {\n    \"firstName\": \"\",\n    \"gender\": \"FEMALE\",\n    \"birthDate\": \"17-05-1990\"\n  }\n]"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('400 Bad Request', () => pm.response.to.have.status(400));",
              "pm.test('detalle por campo', () => pm.expect(pm.response.json().errors).to.be.an('array'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Salud: liveness (pública)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/actuator/health/liveness",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "actuator",
            "health",
            "liveness"
          ]
        },
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('UP', () => pm.expect(pm.response.json().status).to.eql('UP'));"
            ]
          }
        }
      ]
    }
  ]
}
